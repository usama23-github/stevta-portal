generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================
// POSTING PLACES
// =========================

model PostingPlace {
  id            Int      @id @default(autoincrement())
  postingPlace  String   @unique
  order         Int?

  sections      Section[]
  departments   Department[]
  designations  Designation[]
  staff         Staff[]
  leaves        Leave[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// =========================
// SECTIONS
// =========================

model Section {
  id              Int              @id @default(autoincrement())
  section         String

  postingPlaceId  Int
  postingPlace    PostingPlace     @relation(fields: [postingPlaceId], references: [id])

  departmentId    Int?
  department      Department?      @relation(fields: [departmentId], references: [id])

  staff           Staff[]

  leave           Leave[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([section, postingPlaceId, departmentId])
  @@index([postingPlaceId])
  @@index([departmentId])
}

// =========================
// DEPARTMENTS
// =========================

model Department {
  id              Int      @id @default(autoincrement())
  department      String

  postingPlaceId  Int
  postingPlace    PostingPlace @relation(fields: [postingPlaceId], references: [id])

  section         Section[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([department, postingPlaceId])
  @@index([postingPlaceId])
}

// =========================
// REGIONS
// =========================

model Region {
  id          Int      @id

  name        String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  districts   District[]
  leaves      Leave[]
}

// =========================
// DISTRICTS
// =========================

model District {
  id            Int      @id

  name          String

  regionId      Int

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  region Region @relation(fields: [regionId], references: [id])

  subdivisions  Subdivision[]

  @@index([regionId])
}

// =========================
// SUBDIVISIONS
// =========================

model Subdivision {
  id            Int      @id

  name          String

  districtId    Int

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  district District @relation(fields: [districtId], references: [id])

  @@index([districtId])
}

// =========================
// DESIGNATION
// =========================

model Designation {
  id              Int           @id @default(autoincrement())

  designation     String

  scaleId         Int
  postingPlaceId  Int

  scale           Scale         @relation(fields: [scaleId], references: [id])
  postingPlace    PostingPlace  @relation(fields: [postingPlaceId], references: [id])

  staff           Staff[]

  leave           Leave[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([scaleId])
  @@index([postingPlaceId])

  // Prevent duplicate designation names within the same posting place and scale
  @@unique([designation, postingPlaceId, scaleId])
}

// =========================
// STAFF
// =========================

model Staff {
  id              String   @id @default(uuid())

  empNo           String   @unique
  name            String

  designationId   Int?
  department      String?

  postingPlaceId  Int?
  sectionId       Int?
  shiftId         Int?

  designation     Designation?  @relation(fields: [designationId], references: [id])
  postingPlace    PostingPlace? @relation(fields: [postingPlaceId], references: [id])
  section         Section?      @relation(fields: [sectionId], references: [id])
  shift           Shift?        @relation(fields: [shiftId], references: [id])

  attendances     Attendance[]

  leaves          Leave[]

  shiftHistory    StaffShiftHistory[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([postingPlaceId])
  @@index([sectionId])
  @@index([designationId])
  @@index([shiftId])
  @@index([empNo])
  @@index([name])
}

// =========================
// SCALE
// =========================

model Scale {
  id            Int           @id @default(autoincrement())
  scale         String        @unique

  designations  Designation[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// =========================
// ATTENDANCE
// =========================

model Attendance {
  id                 String   @id @default(uuid())

  empNo              String

  attendanceDate     DateTime

  attendanceStatusId Int

  checkInTime        DateTime?
  checkInStatusId    Int?

  checkOutTime       DateTime?
  checkOutStatusId   Int?

  leaveTypeId        Int?

  deviceId           Int?

  staff              Staff    @relation(fields: [empNo], references: [empNo])

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([empNo, attendanceDate])

  @@index([attendanceDate])
  @@index([empNo])
  @@index([attendanceStatusId])
  @@index([checkInStatusId])
  @@index([attendanceDate, attendanceStatusId])
}

// =========================
// ATTENDANCE LOGS
// =========================

model AttendanceLogs {
  id            String   @id @default(uuid())

  empNo         String
  inOutStatus   Int
  dateTime      DateTime
  deviceId      Int

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([empNo, dateTime, deviceId])

  @@index([empNo])
  @@index([dateTime])
  @@index([empNo, dateTime])

}

model LeaveType {
  id          Int      @id @default(autoincrement())

  name        String   @unique

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leaves      Leave[]
}

model Leave {
  id              String   @id @default(uuid())

  staffId         String

  postingPlaceId  Int?

  regionId        Int?

  designationId   Int?

  sectionId       Int?

  leaveTypeId     Int

  fromDate        DateTime

  toDate          DateTime

  totalDays       Decimal   @db.Decimal(5,2)

  reason          String?

  remarks         String?

  createdById     String?

  appliedAt       DateTime @default(now())

  approvedAt      DateTime?

  rejectedAt      DateTime?

  createdAt       DateTime @default(now())

  updatedAt       DateTime @updatedAt

  staff           Staff @relation(fields: [staffId], references: [id])

  postingPlace    PostingPlace? @relation(fields: [postingPlaceId], references: [id])

  region          Region? @relation(fields: [regionId], references: [id])

  designation     Designation? @relation(fields: [designationId], references: [id])

  section         Section? @relation(fields: [sectionId], references: [id])

  leaveType       LeaveType @relation(fields: [leaveTypeId], references: [id])

  createdBy       User? @relation(fields: [createdById], references: [id])

  documents       LeaveDocument[]
}

model LeaveDocument {
  id          String @id @default(uuid())

  leaveId     String

  fileName    String

  filePath    String

  uploadedAt  DateTime @default(now())

  leave       Leave @relation(fields: [leaveId], references: [id])
}

// =========================
// STAFF CATEGORY
// =========================

enum StaffCategory {
  PUBLIC_SERVANT
  CIVIL_SERVANT
  VISITING_FACULTY
}

// =========================
// STAFF TYPE
// =========================

enum StaffType {
  TEACHING
  NON_TEACHING
}

// =========================
// USER
// =========================

model User {
  id            String   @id @default(uuid())

  email         String   @unique
  password      String

  role          UserRole

  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdLeaves Leave[]

}

// =========================
// USER ROLE
// =========================

enum UserRole {
  SUPER_ADMIN
  OFFICE_ADMIN
  INSTITUTE_ADMIN
  STAFF
}

model Shift {
  id              Int      @id @default(autoincrement())
  name            String

  staff           Staff[]
  shiftTimings    ShiftTiming[]
  staffHistory    StaffShiftHistory[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model StaffShiftHistory {
  id              String   @id @default(uuid())

  staffId         String
  shiftId         Int

  effectiveFrom   DateTime
  effectiveTo     DateTime?

  changedById     String?
  reason          String?

  staff           Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  shift           Shift    @relation(fields: [shiftId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([staffId])
  @@index([shiftId])
  @@index([effectiveFrom])
  @@index([effectiveTo])
}

model ShiftTiming {
  id              String   @id @default(uuid())

  shiftId         Int

  shiftStartTime  DateTime
  checkInOnTime   DateTime
  checkInLate     DateTime

  checkOutEarly   DateTime
  checkOutOnTime  DateTime

  effectiveFrom   DateTime
  effectiveTo     DateTime?

  shift           Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([shiftId])
  @@index([effectiveFrom])
  @@index([effectiveTo])
}