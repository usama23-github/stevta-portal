generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================
// POSTING PLACES
// =========================

model PostingPlace {
  id            Int      @id @default(autoincrement())
  postingPlace  String   @unique
  order         Int?

  sections      Section[]
  designations  Designation[]
  staff         Staff[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// =========================
// SECTIONS
// =========================

model Section {
  id              Int      @id @default(autoincrement())
  section         String

  postingPlaceId  Int
  postingPlace    PostingPlace @relation(fields: [postingPlaceId], references: [id])

  staff           Staff[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([section, postingPlaceId])
  @@index([postingPlaceId])
}

// =========================
// REGIONS
// =========================

model Region {
  id          Int      @id

  name        String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  districts   District[]
}

// =========================
// DISTRICTS
// =========================

model District {
  id            Int      @id

  name          String

  regionId      Int

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  region Region @relation(fields: [regionId], references: [id])

  subdivisions  Subdivision[]

  @@index([regionId])
}

// =========================
// SUBDIVISIONS
// =========================

model Subdivision {
  id            Int      @id

  name          String

  districtId    Int

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  district District @relation(fields: [districtId], references: [id])

  @@index([districtId])
}

// =========================
// DESIGNATION
// =========================

model Designation {
  id              Int           @id @default(autoincrement())

  designation     String

  scaleId         Int
  postingPlaceId  Int

  scale           Scale         @relation(fields: [scaleId], references: [id])
  postingPlace    PostingPlace  @relation(fields: [postingPlaceId], references: [id])

  staff           Staff[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([scaleId])
  @@index([postingPlaceId])

  // Prevent duplicate designation names within the same posting place and scale
  @@unique([designation, postingPlaceId, scaleId])
}

// =========================
// STAFF
// =========================

model Staff {
  id              String   @id @default(uuid())

  empNo           String   @unique
  name            String

  designationId   Int?
  department      String?

  postingPlaceId  Int?
  sectionId       Int?

  designation     Designation? @relation(fields: [designationId], references: [id])
  postingPlace    PostingPlace? @relation(fields: [postingPlaceId], references: [id])
  section         Section?      @relation(fields: [sectionId], references: [id])

  attendances     Attendance[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([designationId])
  @@index([postingPlaceId])
  @@index([sectionId])
}

// =========================
// SCALE
// =========================

model Scale {
  id            Int           @id @default(autoincrement())
  scale         String        @unique

  designations  Designation[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// =========================
// ATTENDANCE
// =========================

model Attendance {
  id                 String   @id @default(uuid())

  empNo              String

  attendanceDate     DateTime

  attendanceStatusId Int

  checkInTime        DateTime?
  checkInStatusId    Int?

  checkOutTime       DateTime?
  checkOutStatusId   Int?

  leaveTypeId        Int?

  deviceId           Int?

  staff              Staff    @relation(fields: [empNo], references: [empNo])

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([empNo, attendanceDate])

  @@index([empNo])
  @@index([attendanceDate])
}

// =========================
// ATTENDANCE LOGS
// =========================

model AttendanceLogs {
  id            String   @id @default(uuid())

  empNo         String
  inOutStatus   Int
  dateTime      DateTime
  deviceId      Int

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([empNo, dateTime, deviceId])

}

// =========================
// STAFF CATEGORY
// =========================

enum StaffCategory {
  PUBLIC_SERVANT
  CIVIL_SERVANT
  VISITING_FACULTY
}

// =========================
// STAFF TYPE
// =========================

enum StaffType {
  TEACHING
  NON_TEACHING
}

// =========================
// USER
// =========================

model User {
  id            String   @id @default(uuid())

  email         String   @unique
  password      String

  role          UserRole

  isActive    Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

}

// =========================
// USER ROLE
// =========================

enum UserRole {
  SUPER_ADMIN
  OFFICE_ADMIN
  INSTITUTE_ADMIN
  STAFF
}